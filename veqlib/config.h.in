#pragma once

#include <array>
#include <cstddef>

namespace config
{
    struct Topology
    {
        static constexpr std::size_t Nr = @VEQ_NR@;
        static constexpr std::size_t Nt = @VEQ_NT@;
        static constexpr std::size_t source_sample_count = @VEQ_SOURCE_SAMPLE_COUNT@;

        static constexpr std::size_t h_count     = @VEQ_H_PROFILE_COUNT@;
        static constexpr std::size_t v_count     = @VEQ_V_PROFILE_COUNT@;
        static constexpr std::size_t kappa_count = @VEQ_KAPPA_PROFILE_COUNT@;
        static constexpr std::size_t psin_count  = @VEQ_PSIN_PROFILE_COUNT@;
        static constexpr std::size_t F_count     = @VEQ_F_PROFILE_COUNT@;

        using CosFamilyCounts = std::array<std::size_t, @VEQ_COS_PROFILE_COUNTS_SIZE@>;
        using SinFamilyCounts = std::array<std::size_t, @VEQ_SIN_PROFILE_COUNTS_SIZE@>;

        static constexpr CosFamilyCounts c_family_counts = {
            @VEQ_COS_PROFILE_COUNTS_VALUES@
        };
        static constexpr SinFamilyCounts s_family_counts = {
            @VEQ_SIN_PROFILE_COUNTS_VALUES@
        };

        static constexpr std::size_t C_max        = @VEQ_C_MAX@;
        static constexpr std::size_t S_max        = @VEQ_S_MAX@;
        static constexpr std::size_t active_M_max = @VEQ_ACTIVE_M_MAX@;
        static constexpr std::size_t M_max        = @VEQ_M_MAX@;
        static constexpr std::size_t L_max = @VEQ_L_MAX@;
        static constexpr std::size_t K_max = @VEQ_K_MAX@;

        template <std::size_t Order>
        static consteval std::size_t c_count()
        {
            static_assert(Order < c_family_counts.size(), "c profile order exceeds configured counts");
            return c_family_counts[Order];
        }

        template <std::size_t Order>
        static consteval std::size_t s_count()
        {
            static_assert(Order > 0, "s0 is not a physical sine profile");
            static_assert(Order <= s_family_counts.size(), "s profile order exceeds configured counts");
            return s_family_counts[Order - 1];
        }

        template <std::size_t Order>
        static consteval std::size_t fourier_power()
        {
            return Order < K_max ? Order : K_max;
        }
    };

    static_assert(
        Topology::L_max >= 1,
        "profile polynomial table requires at least one stored row"
    );
    static_assert(
        Topology::M_max >= 1,
        "trig table requires at least one positive harmonic"
    );
    static_assert(
        Topology::K_max >= 2,
        "profile rho table requires rho and rho^2 rows"
    );
} // namespace config
